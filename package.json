{
  "name": "shop-and-care",
  "version": "1.0.0",
  "description": "Tienda web oficial de Shop & Care - Uniformes médicos, accesorios e instrumental básico para estudiantes y profesionales de la salud en Perú",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:frontend": "node ./node_modules/vite/bin/vite.js",
    "dev:backend": "node server/index.js",
    "dev": "node ./node_modules/concurrently/dist/bin/concurrently.js -n \"front,back\" -c \"cyan,magenta\" \"node ./node_modules/vite/bin/vite.js\" \"node server/index.js\"",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.16.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
